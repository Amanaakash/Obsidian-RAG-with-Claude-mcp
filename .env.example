# Documentation example only. The MCP server reads process environment
# variables and does not automatically load this file.

# Use absolute paths. Forward slashes work in JSON and modern Windows tools.
OBSIDIAN_RAG_VAULT=/absolute/path/to/ObsidianVault
OBSIDIAN_RAG_DB=/absolute/path/to/Obsidian-RAG-with-Claude-mcp/.rag_data/my_vault
OBSIDIAN_RAG_MODEL=all-minilm:22m
OBSIDIAN_RAG_COLLECTION=obsidian_notes
OBSIDIAN_RAG_OLLAMA_HOST=http://localhost:11434
